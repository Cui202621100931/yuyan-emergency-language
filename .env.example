# ===== 语安 应急语言服务 · 环境变量 =====
# 复制为 .env 后填写；所有密钥仅在服务端读取，绝不下发到前端。

# 服务端口（默认 8080）
PORT=8080

# DeepSeek：多语翻译、RAG 答案生成（必填，功能二/五的正式模式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 BigModel：向量索引（必填，功能五的正式模式）
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_EMBEDDING_MODEL=embedding-3

# 未配置以上密钥时：
# - 翻译自动降级为 MyMemory 公有接口（可关）→ 语料/术语拼装（演示模式）
# - 问答自动降级为本地 TF-IDF 检索 + 抽取式回答（仍带来源）
ENABLE_PUBLIC_MT=true

# 知识库增量更新令牌（评委演示用，勿写入前端）
ADMIN_TOKEN=yuyan-demo-2026

# 抓取数据快照生成时间（用于页面展示，可留空自动生成）
SNAPSHOT_LABEL=
